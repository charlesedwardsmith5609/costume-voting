# Copy to .env.local for local dev. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_PASSWORD=
# Random 32+ byte string, e.g. `openssl rand -base64 32`
SESSION_SECRET=

# Second Supabase project used only by the test suite (never production).
TEST_SUPABASE_URL=
TEST_SUPABASE_SERVICE_ROLE_KEY=
# Anon (publishable) key of the test project; used only to prove anon cannot call functions.
TEST_SUPABASE_ANON_KEY=
